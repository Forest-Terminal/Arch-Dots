configuration {
	modi:				"drun";
	font:				"Iosevka Bold";
	display-drun: 			"";
	sidebar-mode: 			false;
    show-icons: true;
    icon-theme: "Papirus";
    drun-display-format: "{icon} {name}";
}
@theme "~/.config/rofi/colors/gruvbox.rasi"

* {
font-size: 50px;
}

window {
	transparency:                   "real";
	border-radius:                  7px;
	width:			    	40%;
	y-offset:                       10px;
	padding: 			20px;
	location: 			south;
  background-color: @background;
}

prompt { enabled: false; }

entry {
	placeholder:			"Search";
	expand:                         true;
	padding:                        5px 2% 5px 2%;
	background-color:               @foreground;
  placeholder-color:              @background;
}

inputbar {
	children: 			[ prompt, entry ];
	background-color:               @foreground;
	text-color:                     @background;
	expand:                         false;
	border-radius:                  6px;
	padding:                        8px;
}

listview {
	columns:                        1;
	lines:	                        4;
	cycle:                          false;
	dynamic:                        true;
	layout:                         vertical;
  background-color:               inherit;
}

mainbox {
	children:                       [ inputbar, message, listview ];
	spacing:                       	2%;
	padding:                        2% 1% 2% 1%;
  background-color:               @background;
}

message {
  border-radius:                  0%;
	padding:                        1.5% 0% 1.5% 0%;
  background-color:               inherit;
  }

textbox {
  background-color:               @background;
  text-color:                     @foreground;
  }

element {
	orientation:                    horizontal;
	border-radius:                  0%;
	padding:                        1.5% 0% 1.5% 0%;
  background-color:               inherit;
}

element-text {
	expand:                         true;
	vertical-align:                 0.5;
	margin:                         0.5% 3% 0% 3%;
	background-color:               inherit;
  text-color:                     @foreground;
  font-size:                      32px;
}

element-icon {
  enabled: false;
  }

element selected {
	background-color:               @selected;
	text-color:                     @background;
	border-radius:                  6px;
}
element-text selected {
    text-color: @background;
  }
