{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "arch_small", // search for logos: fastfetch --list-logos or --print-logos
        "padding": {
	        "top": 1,
      "left": 2
	},
	 "color": {             // Override logo colors
        "1": "bright_blue",
	"2": "blue"
    }
    },
    "display": {
        "separator": "  ",
	"color": {
		"title": "magenta"
	}
    },
    "modules": [
	"break",
	{
	   "type": "title",
	},
        {
            "type": "os",
            "key": " ",
            "keyColor": "33",  // = color3
        },
        {
            "type": "kernel",
            "key": " ",
            "keyColor": "33",
        },{
            "type": "wm",
            "key": " ",
            "keyColor": "33",
        },
        {
            "type": "packages",
            "key": " ",
            "keyColor": "33",  
        },
        {
            "type": "uptime",
            "format": "{2}h {3}m",
            "key": " ",
            "keyColor": "33",
        },
        {
            "type": "memory",
            "key": " ",
            "keyColor": "33",
        },
	{
	    "type": "colors",
	    "symbol": "circle"
	},
        "break",
    ]
}
